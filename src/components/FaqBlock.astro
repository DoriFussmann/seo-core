---
interface Faq {
  question: string;
  answer: string;
}
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

{faqs.length > 0 && (
  <section class="mt-12" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="h2">Frequently asked questions</h2>
    {faqs.map((faq) => (
      <details class="faq-item">
        <summary>{faq.question}</summary>
        <p class="muted">{faq.answer}</p>
      </details>
    ))}
  </section>
)}
