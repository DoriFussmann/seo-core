---
interface Source {
  label: string;
  url: string;
  addedAt: string;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="mt-12" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="h2">Sources</h2>
    <ul class="link-list">
      {sources.map((source) => (
        <li>
          <a href={source.url} rel="noopener" target="_blank">{source.label}</a>
        </li>
      ))}
    </ul>
  </section>
)}
