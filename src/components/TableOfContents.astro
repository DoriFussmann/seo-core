---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <nav aria-label="Table of contents" class="toc card">
    <p class="eyebrow">On this page</p>
    <ol class="flex flex-col">
      {toc.map((h) => (
        <li class={h.depth === 3 ? "ml-4" : ""}>
          <a class="py-2 inline-block" href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
