---
import { guardBodyH1 } from "../lib/body-h1";
import { openLinksInNewTab } from "../lib/link-targets";

interface Props {
  title?: string;
  h1?: string;
}

const { title, h1 } = Astro.props;
const html = await Astro.slots.render("default");
const safe = openLinksInNewTab(guardBodyH1(html, title, h1));
---

<Fragment set:html={safe} />
