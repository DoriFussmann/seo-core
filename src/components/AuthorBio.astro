---
interface Props {
  name: string;
  role: string;
  bio: string;
  slug: string;
  photoSrc: string;
  photoAlt: string;
}
const { name, role, bio, slug, photoSrc, photoAlt } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-heading">
  <h2 id="author-heading" class="h2">About the author</h2>
  <div class="flex gap-4 items-start">
    <img src={photoSrc} alt={photoAlt} width="96" height="96" loading="lazy" class="avatar" />
    <div class="flex-1 min-w-0 flex flex-col gap-2">
      <p><a href={`/team/${slug}/`}>{name}</a></p>
      <p class="muted">{role}</p>
      <p>{bio}</p>
    </div>
  </div>
</section>
