---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/formatDate";

interface Props {
  articles: CollectionEntry<"articles">[];
  pillars: string[];
  page: number;
  pages: number;
  articlesBase: string;
}

const { articles, pillars, page, pages, articlesBase } = Astro.props;
---

<form id="article-filters" class="mb-8 flex gap-4 w-full">
  <label class="flex flex-col text-sm w-1/2">
    Search titles
    <input type="search" name="q" id="filter-q" class="border border-border px-3 py-2 min-h-[44px] w-full" />
  </label>
  <label class="flex flex-col text-sm w-1/2">
    Core pillar keyword
    <select name="pillar" id="filter-pillar" class="border border-border px-3 py-2 min-h-[44px] w-full appearance-none bg-surface pr-8 cursor-pointer relative">
      <option value="">All pillars</option>
      {pillars.map((p) => <option value={p}>{p}</option>)}
    </select>
  </label>
</form>
<ul id="article-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {articles.map((article) => (
    <li
      class="article-card group relative border border-border bg-surface transition-shadow hover:shadow-lg cursor-pointer"
      data-title={article.data.title}
      data-pillar={article.data.pillarKeyword ?? ""}
      onclick={`window.location='/${articlesBase}/${article.id}/'`}
    >
      {article.data.pillarKeyword && (
        <p class="px-4 pt-4 text-xs font-medium text-accent uppercase tracking-wide">{article.data.pillarKeyword}</p>
      )}
      <div class="hero-frame mx-4 mt-2 mb-3">
        <Image
          src={article.data.image}
          width={600}
          height={338}
          alt={article.data.imageAlt}
          loading="lazy"
          widths={[320, 480, 600]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        />
      </div>
      <div class="px-4 pb-4">
        <h2 class="font-serif text-xl mb-1 group-hover:text-accent transition-colors">{article.data.title}</h2>
        <p class="text-sm text-muted mb-3">{formatDate(article.data.updatedDate || article.data.date)}</p>
        <span class="inline-block border border-accent text-accent text-sm px-4 py-1 group-hover:bg-accent group-hover:text-surface transition-colors">
          To Article →
        </span>
      </div>
    </li>
  ))}
</ul>
{pages > 1 && (
  <nav class="mt-10 flex gap-3" aria-label="Pagination">
    {page > 1 && (
      <a class="nav-link border border-border" href={page === 2 ? `/${articlesBase}/` : `/${articlesBase}/${page - 1}/`}>Previous</a>
    )}
    {page < pages && (
      <a class="nav-link border border-border" href={`/${articlesBase}/${page + 1}/`}>Next</a>
    )}
  </nav>
)}
<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var qInput = document.getElementById("filter-q");
    var pInput = document.getElementById("filter-pillar");
    var cards = document.querySelectorAll(".article-card");
    if (!qInput || !pInput) return;
    function apply() {
      var q = (qInput.value || "").toLowerCase();
      var pillar = pInput.value || "";
      cards.forEach(function (card) {
        var title = (card.getAttribute("data-title") || "").toLowerCase();
        var p = card.getAttribute("data-pillar") || "";
        var ok = (!q || title.indexOf(q) !== -1) && (!pillar || p === pillar);
        card.style.display = ok ? "" : "none";
      });
    }
    function syncUrl() {
      var next = new URLSearchParams();
      if (qInput.value) next.set("q", qInput.value);
      if (pInput.value) next.set("pillar", pInput.value);
      var qs = next.toString();
      history.replaceState(null, "", window.location.pathname + (qs ? "?" + qs : ""));
    }
    qInput.value = params.get("q") || "";
    pInput.value = params.get("pillar") || "";
    apply();
    qInput.addEventListener("input", function () { apply(); syncUrl(); });
    pInput.addEventListener("change", function () { apply(); syncUrl(); });
  })();
</script>
