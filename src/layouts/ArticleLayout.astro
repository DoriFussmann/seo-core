---
/**
 * Article page shell. Owns every SEO concern of an article: the JSON-LD
 * @graph, meta props handed to the site's Layout, the markdown alternate, the
 * slug guard and the body H1 guard.
 *
 * Presentation is overridable through named slots, so a site keeps its own
 * design while seo-core stays the source of truth:
 *   - "header": replaces breadcrumbs + hero image + <h1> + byline. A replacement
 *     must render exactly one <h1> with `article.data.h1` (the audit enforces it).
 *   - "toc":    replaces the table of contents.
 *   - "footer": replaces FAQ, related links, sources and author bio.
 * Pass `defaultStyles={false}` when the site styles the article column itself.
 */
import { getImage, Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TableOfContents from "../components/TableOfContents.astro";
import FaqBlock from "../components/FaqBlock.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Sources from "../components/Sources.astro";
import AuthorBio from "../components/AuthorBio.astro";
import ArticleBody from "../components/ArticleBody.astro";
import { DEFAULT_TIME_ZONE, zonedDateTime } from "../lib/datetime";
import { formatDate } from "../lib/formatDate";
import { abs } from "../lib/url";
import {
  authorUrl,
  breadcrumbNode,
  faqPageNode,
  orgId,
  orgNode,
  personNode,
  websiteId,
  websiteNode,
  type AuthorPath,
} from "../lib/jsonld";

interface Props {
  article: CollectionEntry<"articles">;
  author: CollectionEntry<"team">;
  Layout: any;
  siteUrl: string;
  siteName: string;
  articlesBase: string;
  /** Organization logo path or URL (raster, at least 112×112px). */
  logo: string;
  sameAs?: string[];
  /** Author profile path. Default "/team/<slug>/". */
  authorPath?: AuthorPath;
  /**
   * IANA time zone for the article timestamps in JSON-LD and article meta
   * ("2026-08-03T00:00:00-07:00"). Default "America/Los_Angeles".
   */
  timeZone?: string;
  /** Open Graph image size. Default 1200×675. */
  ogImageSize?: { width: number; height: number };
  /** Class on the <article> element. Default "article-column". */
  articleClass?: string;
  /** Class on the body wrapper. Default "prose-article". */
  bodyClass?: string;
  /** seo-core's column width and padding. Default true. */
  defaultStyles?: boolean;
}

const {
  article,
  author,
  Layout,
  siteUrl,
  siteName,
  articlesBase,
  logo,
  sameAs = [],
  authorPath,
  timeZone = DEFAULT_TIME_ZONE,
  ogImageSize = { width: 1200, height: 675 },
  articleClass = "article-column",
  bodyClass = "prose-article",
  defaultStyles = true,
} = Astro.props;

const data = article.data;
const slug = article.id;
if (data.slug && data.slug !== slug) {
  throw new Error(`Article slug "${data.slug}" does not match its filename "${slug}.md"`);
}

const { Content, headings } = await render(article);
// Resolved by articleSchema; the fallback covers sites still on a raw schema.
const heading = data.h1 || data.title;
const canonicalPath = `/${articlesBase}/${slug}/`;
const pageUrl = abs(canonicalPath, siteUrl);
const dateModified = data.updatedDate || data.date;
const showUpdated = Boolean(data.updatedDate) && data.updatedDate! > data.date;
const publishedAt = zonedDateTime(data.date, timeZone);
const modifiedAt = zonedDateTime(dateModified, timeZone);
const language = data.locale.replace("_", "-");
const site = { siteUrl, siteName, logo, sameAs };
const profileUrl = authorUrl(author.id, siteUrl, authorPath);
const profileHref = profileUrl.slice(new URL(profileUrl).origin.length);

const og = await getImage({ src: data.image, width: ogImageSize.width, height: ogImageSize.height });
const ogAbs = abs(og.src, siteUrl);
const authorPhoto = await getImage({ src: author.data.photo, width: 96, height: 96 });

const crumbs = [
  { name: "Home", href: abs("/", siteUrl) },
  { name: "Articles", href: abs(`/${articlesBase}/`, siteUrl) },
  { name: data.title, href: pageUrl },
];

const person = personNode({
  slug: author.id,
  name: author.data.name,
  role: author.data.role,
  description: author.data.bio.replace(/\s+/g, " ").trim().slice(0, 300),
  image: abs(authorPhoto.src, siteUrl),
  sameAs: author.data.sameAs,
  knowsAbout: author.data.knowsAbout,
  siteUrl,
  authorPath,
});

const about = [
  ...(data.pillarKeyword ? [{ "@type": "Thing", name: data.pillarKeyword }] : []),
  ...data.tags.map((tag) => ({ "@type": "Thing", name: tag })),
];

const articleNode: Record<string, unknown> = {
  "@type": data.schemaType,
  "@id": `${pageUrl}#article`,
  headline: data.title,
  description: data.description,
  image: [ogAbs],
  datePublished: publishedAt,
  dateModified: modifiedAt,
  inLanguage: language,
  author: { "@id": person["@id"] },
  publisher: { "@id": orgId(siteUrl) },
  mainEntityOfPage: { "@id": pageUrl },
  isPartOf: { "@id": websiteId(siteUrl) },
  keywords: data.tags.join(", "),
  wordCount: (article.body ?? "").split(/\s+/).filter(Boolean).length,
  about,
};
if (data.pillarKeyword) articleNode.articleSection = data.pillarKeyword;

const breadcrumb = breadcrumbNode(crumbs, siteUrl);
const webPageNode = {
  "@type": "WebPage",
  "@id": pageUrl,
  url: pageUrl,
  name: data.title,
  inLanguage: language,
  dateModified: modifiedAt,
  isPartOf: { "@id": websiteId(siteUrl) },
  breadcrumb: { "@id": breadcrumb["@id"] },
};

const graph: unknown[] = [orgNode(site), websiteNode(site), person, breadcrumb, webPageNode, articleNode];
if (data.faqs.length) graph.push(faqPageNode(data.faqs, pageUrl));

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<Layout
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={ogAbs}
  robots={data.robots}
  locale={data.locale}
  twitterCard={data.twitterCard}
  jsonLd={jsonLd}
  alternateMarkdown={`${canonicalPath}index.md`}
  articleMeta={{
    publishedTime: publishedAt,
    modifiedTime: modifiedAt,
    author: author.data.name,
    tags: data.tags,
    section: data.pillarKeyword,
  }}
>
  <article class:list={[articleClass, { "seo-core-article": defaultStyles }]}>
    <slot name="header">
      <Breadcrumbs crumbs={crumbs} />
      <div class="media-frame mb-6">
        <Image
          src={data.image}
          width={1200}
          height={675}
          alt={data.imageAlt}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <header class="mb-8 flex flex-col gap-3">
        <h1 class="h1">{heading}</h1>
        <p class="muted">
          By <a href={profileHref}>{author.data.name}</a>
          · <time datetime={data.date}>{formatDate(data.date)}</time>
          {showUpdated && (
            <> · Updated on <time datetime={data.updatedDate}>{formatDate(data.updatedDate!)}</time></>
          )}
        </p>
      </header>
    </slot>
    <slot name="toc">
      <TableOfContents headings={headings} />
    </slot>
    <div class={bodyClass} data-article-body>
      <ArticleBody title={data.title} h1={heading}><Content /></ArticleBody>
    </div>
    <slot name="footer">
      <FaqBlock faqs={data.faqs} />
      <RelatedLinks links={data.internalLinks} articlesBase={articlesBase} />
      <Sources sources={data.externalLinks} />
      <AuthorBio
        name={author.data.name}
        role={author.data.role}
        bio={author.data.bio}
        href={profileHref}
        photoSrc={authorPhoto.src}
        photoAlt={`${author.data.name} headshot`}
      />
    </slot>
  </article>
</Layout>

<style>
  .seo-core-article {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--article-max-width, 90rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
    padding-block: 2.5rem;
  }
</style>
